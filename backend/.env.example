# Servidor
PORT=3000
NODE_ENV=development

# GitHub (obrigatório o username, token é opcional)
GITHUB_USERNAME=clcmo
# Crie um token "fine-grained" ou "classic" apenas para leitura pública, se quiser mais cota
GITHUB_TOKEN=ghp_

# Cache (em segundos)
CACHE_TTL_SECONDS=300

# Paginação da API do GitHub
GITHUB_PER_PAGE=100
GITHUB_MAX_PAGES=2

# Banco (Railway preenche DATABASE_URL automaticamente ao provisionar Postgres)
DATABASE_URL="mongodb://mongo:
# Habilitar sincronização opcional no banco (true/false)
ENABLE_DB_SYNC=false