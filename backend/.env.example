# Servidor
PORT=5556
NODE_ENV=development

# Segredo de administração (mínimo 16 caracteres)
ADMIN_SECRET=replace-this-with-a-long-random-secret

# Origens CORS adicionais, separadas por vírgula e sem caminhos
CORS_ORIGINS=

# GitHub (obrigatório o username, token é opcional)
GITHUB_USERNAME=
# Crie um token "fine-grained" ou "classic" apenas para leitura pública, se quiser mais cota
GITHUB_TOKEN=

# Itens retornados por página do GitHub
GITHUB_PER_PAGE=100

# Banco (Railway preenche DATABASE_URL automaticamente ao provisionar MongoDB)
DATABASE_URL=