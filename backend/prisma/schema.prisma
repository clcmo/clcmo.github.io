generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Project {
  id         String    @id @map("_id") @default(cuid())
  githubId   BigInt    @unique
  name       String
  fullName   String
  htmlUrl    String
  description String? 
  homepage   String?
  language   String?
  topics     String[]
  stars      Int
  forks      Int
  visibility String
  archived   Boolean   @default(false)
  license    String?
  createdAt  DateTime
  pushedAt   DateTime
  updatedAt  DateTime
  syncedAt   DateTime  @default(now())

  @@index([name])
}


model Visitor {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ip        String
  userAgent String
  path      String
  createdAt DateTime @default(now())
  
  @@index([createdAt])
  @@index([path])
}

model GitHubSync {
  id        String   @id @map("_id") @default(cuid())
  lastSync  DateTime @default(now())
  reposCount Int     @default(0)
  status    String   @default("success")
  message   String?
}
