{
  "expo": {
    "name": "Portfolio",
    "slug": "portfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "portfolio",
    "userInterfaceStyle": "light",

    "icon": "./public/icon.png",

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },

    "ios": {
      "supportsTablet": true
    },

    "splash": {
      "image": "./public/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/favicon.ico"
    },

    "plugins": ["expo-router"]
  }
}